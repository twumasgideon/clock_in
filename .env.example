# --- Choose ONE MongoDB URI ---

# Local (PC only — not reachable from Vercel):
# MONGODB_URI=mongodb://127.0.0.1:27017

# MongoDB Atlas (required for Vercel):
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

MONGODB_DATABASE=apc_attendance

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Optional — SMS notices to member phones (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+233XXXXXXXXX
